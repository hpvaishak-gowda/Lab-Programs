#include <stdio.h> 
#define MAX 10 
int stack[MAX], top = -1; 
void push() { 
if (top >= MAX - 1) { printf("Stack Overflow! Storage full.\n"); return; } 
int id; printf("Enter Parcel ID: "); scanf("%d", &id); 
printf("Parcel %d added!\n", stack[++top] = id); 
} 
void pop() { 
printf(top < 0 ? "Stack Underflow! Storage empty.\n" : "Parcel %d removed!\n", 
stack[top--]); 
} 
void display() { 
if (top < 0) { printf("Storage empty.\n"); return; } 
printf("\nParcels (%d total):\n", top + 1); 
for (int i = top; i >= 0; i--) printf("%s%d\n", i == top ? "-> " : "   ", stack[i]); 
} 
